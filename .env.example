# RelayLab local development configuration.
# Copy to .env and adjust. Every value here is a non-secret, dev-only placeholder.
# Never put real credentials in this file or commit a filled-in .env.

# --- Application -----------------------------------------------------------
APP_ENV=development
# Must match the URL you open in the browser (http://localhost:$WEB_HOST_PORT).
APP_ORIGIN=http://localhost:5173
HTTP_ADDR=:8080
WORKER_HEALTH_ADDR=:8081
LOG_LEVEL=info
# Comma-separated CIDRs whose X-Forwarded-For is trusted. Empty = trust none.
TRUSTED_PROXY_CIDRS=
SHUTDOWN_GRACE=20s

# --- Database --------------------------------------------------------------
# Runtime connection (app_runtime role: DML only, no DDL).
DATABASE_URL=postgres://app_runtime:dev-only-app-runtime@localhost:54320/relaylab?sslmode=disable
# Migration connection (app_migrator role). Only `relaylab migrate` reads this.
MIGRATION_DATABASE_URL=postgres://app_migrator:dev-only-app-migrator@localhost:54320/relaylab?sslmode=disable

# Bootstrap superuser for the local Postgres container only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-postgres
POSTGRES_DB=relaylab
# Host port for the local Postgres container (avoids clashing with other local Postgres instances).
POSTGRES_HOST_PORT=54320

# Role passwords used by deploy/local/initdb when the local database is created.
APP_MIGRATOR_PASSWORD=dev-only-app-migrator
APP_RUNTIME_PASSWORD=dev-only-app-runtime
AUTH_MIGRATOR_PASSWORD=dev-only-auth-migrator
AUTH_RUNTIME_PASSWORD=dev-only-auth-runtime

# --- Local host ports (change if something else already uses them) --------
API_HOST_PORT=8080
WORKER_HOST_PORT=8081
WEB_HOST_PORT=5173
POSTGRES_TEST_HOST_PORT=54321

# --- Limits (optional overrides; defaults live in internal/platform/config/limits.go)
# LIMIT_HTTP_MAX_HEADER_BYTES=32768
# LIMIT_API_MAX_BODY_BYTES=65536
