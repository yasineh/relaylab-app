# RelayLab local development configuration.
# Copy to .env and adjust. Every value here is a non-secret, dev-only placeholder.
# Never put real credentials in this file or commit a filled-in .env.

# --- Application -----------------------------------------------------------
APP_ENV=development
# Must match the URL you open in the browser (http://localhost:$WEB_HOST_PORT).
APP_ORIGIN=http://localhost:5173
HTTP_ADDR=:8080
WORKER_HEALTH_ADDR=:8081
LOG_LEVEL=info
# Comma-separated CIDRs whose X-Forwarded-For is trusted. Empty = trust none.
TRUSTED_PROXY_CIDRS=
SHUTDOWN_GRACE=20s
# How often live event streams re-check the session and project (1s to 60s).
STREAM_REVALIDATE_INTERVAL=60s

# --- Database --------------------------------------------------------------
# Runtime connection (app_runtime role: DML only, no DDL).
DATABASE_URL=postgres://app_runtime:dev-only-app-runtime@localhost:54320/relaylab?sslmode=disable
# Direct (unpooled) connection for LISTEN and the retention lock. Set it when
# DATABASE_URL goes through a transaction-mode pooler (Neon's pooled endpoint,
# PgBouncer); defaults to DATABASE_URL. Production URLs must use sslmode=require.
# DATABASE_DIRECT_URL=
# Migration connection (app_migrator role). Only `relaylab migrate` reads this.
MIGRATION_DATABASE_URL=postgres://app_migrator:dev-only-app-migrator@localhost:54320/relaylab?sslmode=disable

# Bootstrap superuser for the local Postgres container only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-postgres
POSTGRES_DB=relaylab
# Host port for the local Postgres container (avoids clashing with other local Postgres instances).
POSTGRES_HOST_PORT=54320

# Role passwords used by deploy/local/initdb when the local database is created.
APP_MIGRATOR_PASSWORD=dev-only-app-migrator
APP_RUNTIME_PASSWORD=dev-only-app-runtime
AUTH_MIGRATOR_PASSWORD=dev-only-auth-migrator
AUTH_RUNTIME_PASSWORD=dev-only-auth-runtime

# --- Authentication (Better Auth service in auth/, reached via the api's /api/auth proxy)
# Shared by the auth service and the api: signs and verifies session cookies.
# Rotating it signs everyone out. Production: generate with `openssl rand -base64 48`.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-not-for-production-0001
# Sent by the api on every proxied request; the auth service rejects requests without it.
AUTH_PROXY_SHARED_SECRET=dev-only-auth-proxy-secret-not-for-production-0002
AUTH_SERVICE_URL=http://localhost:3001
AUTH_PORT=3001
# Defaults: sign-up on in development, off in production; verification on everywhere.
AUTH_SIGNUP_ENABLED=true
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Runtime connection for the auth service (auth_runtime role: DML on schema auth only).
AUTH_DATABASE_URL=postgres://auth_runtime:dev-only-auth-runtime@localhost:54320/relaylab?sslmode=disable
# Better Auth migrations (auth_migrator role). Only `pnpm --filter @relaylab/auth migrate` reads this.
AUTH_MIGRATION_DATABASE_URL=postgres://auth_migrator:dev-only-auth-migrator@localhost:54320/relaylab?sslmode=disable

# --- Webhook endpoints
# Receiving URLs are <INGEST_BASE_URL>/h/<token>. Empty = APP_ORIGIN (the Vite dev
# server forwards /h/* to the API locally; one origin serves both in production).
INGEST_BASE_URL=
# Endpoint tokens are stored only as an HMAC lookup hash and an AES-256-GCM
# ciphertext. Both keys are base64 of 32 bytes. These decode to readable dev-only
# strings; in production generate each with `openssl rand -base64 32`.
# Losing the encryption key means existing URLs cannot be shown again (rotate them).
ENDPOINT_TOKEN_HMAC_KEY=ZGV2LW9ubHktZW5kcG9pbnQtaG1hYy1rZXktMDAwMDE=
ENDPOINT_TOKEN_ENC_KEY=ZGV2LW9ubHktZW5kcG9pbnQtZW5jLWtleS0wMDAwMDI=

# --- Mail (Mailpit locally: SMTP on 1025, inbox UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="RelayLab <no-reply@relaylab.localhost>"

# --- Local host ports (change if something else already uses them) --------
API_HOST_PORT=8080
WORKER_HOST_PORT=8081
WEB_HOST_PORT=5173
POSTGRES_TEST_HOST_PORT=54321
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# --- Limits (optional overrides; defaults live in internal/platform/config/limits.go)
# LIMIT_HTTP_MAX_HEADER_BYTES=32768
# LIMIT_API_MAX_BODY_BYTES=65536
# LIMIT_AUTH_PROXY_TIMEOUT_SECONDS=10
# LIMIT_PROJECTS_PER_USER=20
# LIMIT_ENDPOINTS_PER_PROJECT=25
# Webhook ingestion (rates are per API instance).
# LIMIT_INGEST_MAX_BODY_BYTES=262144
# LIMIT_INGEST_MAX_HEADER_FIELDS=100
# LIMIT_INGEST_BODY_TIMEOUT_SECONDS=10
# LIMIT_INGEST_RATE_PER_ENDPOINT_PER_MINUTE=60
# LIMIT_INGEST_RATE_ENDPOINT_BURST=30
# LIMIT_INGEST_RATE_PER_IP_PER_MINUTE=120
# LIMIT_INGEST_RATE_IP_BURST=60
# List pages (LIMIT_PAGE_DEFAULT must not exceed LIMIT_PAGE_MAX).
# LIMIT_PAGE_DEFAULT=50
# LIMIT_PAGE_MAX=100
# Live event streams one user may hold open at once (per API instance).
# LIMIT_STREAMS_PER_USER=5

# --- Replay (api and worker) -----------------------------------------------
# Replay to URLs. Off by default in production; set REPLAY_ENABLED=true there
# explicitly. Replay to a test sink never leaves RelayLab and always works.
# REPLAY_ENABLED=true
# Encrypts header override values at rest (exactly 32 bytes, base64). Required
# when replay is enabled; generate with `openssl rand -base64 32`. Dev-only value:
REPLAY_OVERRIDE_ENC_KEY=ZGV2LW9ubHktcmVwbGF5LW92ZXJyaWRlLWtleS0wMDM=
# Limits.
# REPLAY_PROJECT_CONCURRENCY=2
# REPLAY_PROJECT_QUEUE_DEPTH=20
# REPLAY_USER_RATE_PER_MINUTE=30
# REPLAY_MAX_TRIES=3
# REPLAY_LEASE_SECONDS=60
# REPLAY_MAX_LEASE_LOSSES=3
# REPLAY_RESPONSE_EXCERPT_BYTES=65536

# --- Data retention (worker purges; api reports the event TTL and cap) -----
# Go durations (h, m, s; no days). Events and their replays older than the TTL
# are deleted; 24h for a public demo deployment. 0 disables the time-based
# purge in development only (rejected in production).
# RETENTION_EVENT_TTL=168h
# Oldest events beyond this many per project are deleted on each run.
# RETENTION_MAX_EVENTS_PER_PROJECT=10000
# RETENTION_AUDIT_TTL=2160h
# Finished (done or dead) background jobs.
# RETENTION_JOB_TTL=168h
# Time between purge runs.
# RETENTION_INTERVAL=10m

# --- Outbound requests: replay destinations (worker) -----------------------
# HTTPS only. http:// (and port 80) only for local development; the worker
# refuses to start with this enabled when APP_ENV=production.
OUTBOUND_ALLOW_HTTP=false
# Destination ports allowed.
# OUTBOUND_ALLOWED_PORTS=443,8443
# Extra host names (and their subdomains) that are never destinations. The
# hosts of APP_ORIGIN, INGEST_BASE_URL, and DATABASE_URL, metadata.google.internal,
# and internal names (localhost, *.internal, *.local, ...) are always blocked.
# OUTBOUND_BLOCKED_HOSTS=
# Timeouts (each at most 1m) and limits.
# OUTBOUND_CONNECT_TIMEOUT=3s
# OUTBOUND_TLS_TIMEOUT=3s
# OUTBOUND_HEADER_TIMEOUT=5s
# OUTBOUND_TOTAL_TIMEOUT=10s
# Response body kept, in bytes (at most 262144); longer bodies are truncated.
# OUTBOUND_MAX_RESPONSE_BYTES=65536
# Requests in flight per worker process.
# OUTBOUND_MAX_CONCURRENCY=8

# --- Webhook ingestion (optional)
# Extra header and query parameter names whose values are redacted on arrival,
# on top of the built-in credential rules (comma-separated, exact names).
# INGEST_REDACT_EXTRA_HEADERS=
# INGEST_REDACT_EXTRA_PARAMS=
# Serve Prometheus /metrics on a separate, private listener. Never the public port.
# METRICS_ADDR=127.0.0.1:9090
