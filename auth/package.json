{
  "name": "@relaylab/auth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "RelayLab authentication service (Better Auth), reached only through the Go API proxy",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "../backend/scripts/with-env.sh node --watch src/main.ts",
    "start": "node src/main.ts",
    "migrate": "../backend/scripts/with-env.sh node src/cli/migrate.ts",
    "create-user": "../backend/scripts/with-env.sh node src/cli/create-user.ts",
    "ci:migrate": "node src/cli/ci-migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "../backend/scripts/with-env.sh ./scripts/test.sh",
    "test:watch": "../backend/scripts/with-env.sh sh -c 'RELAYLAB_TEST_DATABASE_URL=${RELAYLAB_TEST_DATABASE_URL:-postgres://postgres:test-only-postgres@localhost:${POSTGRES_TEST_HOST_PORT:-54321}/postgres?sslmode=disable} vitest'"
  },
  "dependencies": {
    "@zxcvbn-ts/language-common": "^4.1.3",
    "better-auth": "1.7.18",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "jose": "^6.2.15",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
