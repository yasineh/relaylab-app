# Production-mode local stack: TLS in front of the api, so Secure cookies and
# the production origin checks behave as on Cloud Run.
{
	local_certs
	skip_install_trust
	admin off
	# Above the API's 32 KiB header limit, so the API's own limit and JSON
	# error decide, as behind Cloud Run's front end.
	servers {
		max_header_size 64KiB
	}
}

https://localhost:8443 {
	tls internal
	reverse_proxy api:8080
}
