{
  "displayName": "RelayLab server errors",
  "documentation": {
    "content": "relaylab-app is answering with 5xx responses. Check Error Reporting and the request logs (filter severity=ERROR). See docs/deployment.md, section Monitoring.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "5xx responses above 1 per minute",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"relaylab-app\" AND metric.label.response_code_class=\"5xx\"",
        "aggregations": [
          { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM" }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.0167,
        "duration": "300s"
      }
    }
  ],
  "notificationChannels": ["${ALERT_NOTIFICATION_CHANNEL}"]
}
