{
  "name": "@relaylab/e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "End-to-end browser tests against the full Docker Compose stack (docker-compose.e2e.yml)",
  "scripts": {
    "stack:up": "docker compose -f ../docker-compose.e2e.yml up -d --build --wait",
    "stack:down": "docker compose -f ../docker-compose.e2e.yml down -v",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "install-browser": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "oxlint": "^1.92.0",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  }
}
