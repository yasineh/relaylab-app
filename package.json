{
  "name": "relaylab",
  "private": true,
  "description": "RelayLab: receive, inspect, replay, and debug webhooks",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:roles && pnpm migrate && pnpm -r --parallel run \"/^dev(:api|:worker)?$/\"",
    "dev:web": "pnpm --filter @relaylab/web dev",
    "dev:backend": "pnpm db:up && pnpm db:roles && pnpm migrate && pnpm --filter @relaylab/backend --parallel run \"/^dev:(api|worker)$/\"",
    "dev:auth": "pnpm --filter @relaylab/auth dev",
    "dev:docker": "docker compose up --build",
    "db:up": "docker compose up -d --wait postgres mailpit",
    "db:down": "docker compose down",
    "db:roles": "docker compose exec -T postgres sh /docker-entrypoint-initdb.d/00_roles.sh",
    "migrate": "pnpm --filter @relaylab/auth migrate && pnpm --filter @relaylab/backend migrate",
    "create-user": "pnpm --filter @relaylab/auth create-user",
    "build": "pnpm --filter @relaylab/web build && pnpm --filter @relaylab/backend build:embed",
    "test": "pnpm -r test",
    "test:contract": "./backend/scripts/auth-contract.sh",
    "e2e": "pnpm --filter @relaylab/e2e stack:up && pnpm --filter @relaylab/e2e e2e",
    "e2e:down": "pnpm --filter @relaylab/e2e stack:down",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "sqlc": "pnpm --filter @relaylab/backend sqlc",
    "deploy:check": "deploy/render.sh --check && docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.7@sha256:887a259a5a534f3c4f36cb02dca341673c6089431057242cdc931e9f133147e9 -no-color",
    "secrets:scan": "docker run --rm -v \"$PWD:/repo\" zricethezav/gitleaks:v8.30.1 dir --config /repo/.gitleaks.toml --redact=100 --verbose /repo"
  }
}
